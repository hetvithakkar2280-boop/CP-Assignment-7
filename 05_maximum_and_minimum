#include <stdio.h>

// Function uses pointers (call by reference) to update min and max
void findMinMax(int arr[], int n, int *min, int *max) {
    *min = arr[0];
    *max = arr[0];

    for (int i = 1; i < n; i++) {
        if (arr[i] < *min) {
            *min = arr[i];
        }
        if (arr[i] > *max) {
            *max = arr[i];
        }
    }
}

int main() {
    int n, minVal, maxVal;
    printf("Enter the number of elements: ");
    scanf("%d", &n);

    int arr[n];
    printf("Enter %d elements: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Passing addresses of minVal and maxVal
    findMinMax(arr, n, &minVal, &maxVal);

    printf("Minimum value: %d\n", minVal);
    printf("Maximum value: %d\n", maxVal);

    return 0;
}
