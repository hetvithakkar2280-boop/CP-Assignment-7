#include <stdio.h>
/* Q7: all the above programs (1 to 6) combined in one menu-driven program. */
long long power(int a, int b) {
long long result = 1;
int i;
for (i = 1; i <= b; i++)
result = result * a;
return result;
int isLeap(int year) {
return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
}
}
unsigned long long factorial(int n) {
if (n <= 1)
return 1;
return n * factorial(n - 1);
}
void swapByValue(int a, int b) {
int temp = a;
a = b;
b = temp;
printf("Inside swap function : a = %d, b = %d\n", a, b);
}
void findMaxMin(int arr[], int n, int *max, int *min) {
int i;
*max = *min = arr[0];
for (i = 1; i < n; i++) {
if (arr[i] > *max)
*max = arr[i];
if (arr[i] < *min)
*min = arr[i];
}
}
float add(float a, float b) { return a + b; }
float subtract(float a, float b) { return a - b; }
float multiply(float a, float b) { return a * b; }
float divide(float a, float b) { return a / b; }
int main() {
int choice;
do {
printf("\n===== MENU =====\n");
printf("1. Power (a^b)\n");
printf("2. Leap year\n");
printf("3. Factorial (recursion)\n");
printf("4. Swap (call by value)\n");
printf("5. Max & min of array (call by reference)\n");
printf("6. Calculator\n");
printf("0. Exit\n");
printf("Enter your choice: ");
scanf("%d", &choice);
if (choice == 1) {
int a, b;
printf("Enter base and exponent: ");
scanf("%d %d", &a, &b);
if (b < 0)
printf("Please enter a non-negative exponent.\n");
else
printf("%d^%d = %lld\n", a, b, power(a, b));
} else if (choice == 2) {
int year;
printf("Enter a year: ");
scanf("%d", &year);
if (isLeap(year))
printf("%d is a leap year.\n", year);
else
printf("%d is not a leap year.\n", year);
} else if (choice == 3) {
int n;
printf("Enter a number: ");
scanf("%d", &n);
if (n < 0)
printf("Factorial is not defined for negative numbers.\n");
else
printf("%d! = %llu\n", n, factorial(n));
} else if (choice == 4) {
int x, y;
printf("Enter two integers: ");
scanf("%d %d", &x, &y);
printf("Before calling swap : x = %d, y = %d\n", x, y);
swapByValue(x, y);
printf("After calling swap : x = %d, y = %d\n", x, y);
} else if (choice == 5) {
int arr[50], n, i, max, min;
printf("Enter number of elements: ");
scanf("%d", &n);
printf("Enter %d values:\n", n);
for (i = 0; i < n; i++)
scanf("%d", &arr[i]);
findMaxMin(arr, n, &max, &min);
printf("Maximum = %d, Minimum = %d\n", max, min);
} else if (choice == 6) {
float a, b;
char op;
printf("Enter two numbers: ");
scanf("%f %f", &a, &b);
printf("Enter operator (+, -, *, /): ");
scanf(" %c", &op);
if (op == '+')
printf("Result = %.2f\n", add(a, b));
else if (op == '-')
printf("Result = %.2f\n", subtract(a, b));
else if (op == '*')
printf("Result = %.2f\n", multiply(a, b));
else if (op == '/' && b != 0)
printf("Result = %.2f\n", divide(a, b));
else
printf("Invalid operator or division by zero.\n");
} else if (choice != 0) {
printf("Invalid choice.\n");
}
} while (choice != 0);
return 0;
}
