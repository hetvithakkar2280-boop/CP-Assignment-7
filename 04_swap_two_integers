#include <stdio.h>

// Swap function using call by value
void swapByValue(int x, int y) {
    int temp = x;
    x = y;
    y = temp;
    printf("Inside function (after swap): a = %d, b = %d\n", x, y);
}

int main() {
    int a, b;
    printf("Enter two integers (a and b): ");
    scanf("%d %d", &a, &b);

    printf("Before function call: a = %d, b = %d\n", a, b);
    swapByValue(a, b);
    printf("After function call (original values unchanged): a = %d, b = %d\n", a, b);

    return 0;
}
